{
  "allowlist": [
    "زيزو",
    "PHOENIX-9941",
    "gateway-service",
    "Bolla-Agentic-OS-EGM-SRE",
    "SMS"
  ],
  "patterns": [
    {
      "category": "PRIVATE_KEY",
      "name": "pem_block",
      "regex": "-----B[E]GIN [A-Z0-9 ]*PRIV[A]TE KEY(?: BLOCK)?-----[\\s\\S]*?-----E[N]D [A-Z0-9 ]*PRIV[A]TE KEY(?: BLOCK)?-----"
    },
    {
      "category": "URL_WITH_CREDS",
      "name": "userinfo_any_scheme",
      "regex": "(?<![\\w])[A-Za-z][A-Za-z0-9+.\\-]*://([^\\s/:@]+:[^\\s@/]+)@",
      "group": 1
    },
    {
      "category": "URL_WITH_CREDS",
      "name": "proxy_four_part",
      "regex": "(?<![\\w.\\-])(?:\\d{1,3}(?:\\.\\d{1,3}){3}|[A-Za-z0-9\\-]+(?:\\.[A-Za-z0-9\\-]+)+):\\d{2,5}:([^\\s:@/]{3,}:[^\\s:@/]{3,})(?![^\\s,;)\\]\"'])",
      "group": 1
    },
    {
      "category": "URL_TOKEN",
      "name": "url_query_or_fragment_token",
      "regex": "[?#&]/?(?:access_token|auth_token|id_token|refresh_token|token|api_key|apikey|secret|sig|signature|magic|session_?id|auth|code)=([A-Za-z0-9_\\-.%~+/]{16,})",
      "flags": "I",
      "group": 1
    },
    {
      "category": "OAUTH_JWT",
      "name": "google_ya29",
      "regex": "(?<![\\w\\-])ya29\\.[A-Za-z0-9_\\-]{20,}"
    },
    {
      "category": "OAUTH_JWT",
      "name": "google_refresh",
      "regex": "(?<![\\w])1//0[A-Za-z0-9_\\-]{20,}"
    },
    {
      "category": "OAUTH_JWT",
      "name": "jwt",
      "regex": "(?<![\\w\\-])eyJ[A-Za-z0-9_\\-]{8,}\\.eyJ[A-Za-z0-9_\\-]{8,}\\.[A-Za-z0-9_\\-]{8,}"
    },
    {
      "category": "OAUTH_JWT",
      "name": "bearer",
      "regex": "(?<![\\w])Bearer[ \\t]+[A-Za-z0-9\\-_.=+/]{16,}",
      "flags": "I"
    },
    {
      "category": "OAUTH_JWT",
      "name": "basic_auth",
      "regex": "(?<![\\w])Basic[ \\t]+[A-Za-z0-9+/]{16,}={0,2}",
      "flags": "I"
    },
    {
      "category": "GITHUB_TOKEN",
      "name": "gh_classic",
      "regex": "(?<![\\w])(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}"
    },
    {
      "category": "GITHUB_TOKEN",
      "name": "gh_fine_grained",
      "regex": "(?<![\\w])github_pat_[A-Za-z0-9_]{22,}"
    },
    {
      "category": "WEBHOOK",
      "name": "slack_webhook",
      "regex": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/_\\-]+"
    },
    {
      "category": "WEBHOOK",
      "name": "discord_webhook",
      "regex": "https://(?:canary\\.|ptb\\.)?discord(?:app)?\\.com/api/webhooks/\\d+/[A-Za-z0-9_\\-]+"
    },
    {
      "category": "API_KEY",
      "name": "openai_anthropic_sk",
      "regex": "(?<![\\w\\-])sk-[A-Za-z0-9_\\-]{20,}"
    },
    {
      "category": "API_KEY",
      "name": "google_aiza",
      "regex": "(?<![\\w\\-])AIza[0-9A-Za-z_\\-]{35}(?![\\w\\-])"
    },
    {
      "category": "API_KEY",
      "name": "upstage_up",
      "regex": "(?<![\\w\\-])up_[A-Za-z0-9]{20,}"
    },
    {
      "category": "API_KEY",
      "name": "slack_xox",
      "regex": "(?<![\\w\\-])(?:xox[abpors]|xapp)-[A-Za-z0-9\\-]{10,}"
    },
    {
      "category": "API_KEY",
      "name": "aws_access_key_id",
      "regex": "(?<![\\w])(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA)[0-9A-Z]{16}(?![\\w])"
    },
    {
      "category": "API_KEY",
      "name": "stripe_secret",
      "regex": "(?<![\\w\\-])(?:[sr]k_(?:live|test)_[A-Za-z0-9]{16,}|whsec_[A-Za-z0-9]{20,})"
    },
    {
      "category": "API_KEY",
      "name": "google_oauth_client_secret",
      "regex": "(?<![\\w\\-])GOCSPX-[A-Za-z0-9_\\-]{20,}"
    },
    {
      "category": "API_KEY",
      "name": "sendgrid",
      "regex": "(?<![\\w])SG\\.[A-Za-z0-9_\\-]{16,}\\.[A-Za-z0-9_\\-]{32,}"
    },
    {
      "category": "API_KEY",
      "name": "twilio_sid_or_key",
      "regex": "(?<![\\w])(?:AC|SK)[0-9a-fA-F]{32}(?![\\w])"
    },
    {
      "category": "API_KEY",
      "name": "huggingface",
      "regex": "(?<![\\w\\-])hf_[A-Za-z0-9]{30,}"
    },
    {
      "category": "API_KEY",
      "name": "npm_token",
      "regex": "(?<![\\w\\-])npm_[A-Za-z0-9]{30,}"
    },
    {
      "category": "API_KEY",
      "name": "azure_account_key",
      "regex": "AccountKey=[A-Za-z0-9+/]{40,}={0,2}",
      "flags": "I"
    },
    {
      "category": "API_KEY",
      "name": "supabase_sbp",
      "regex": "(?<![\\w\\-])sbp_[A-Za-z0-9]{30,}"
    },
    {
      "category": "API_KEY",
      "name": "firebase_server_key",
      "regex": "(?<![\\w])AAAA[A-Za-z0-9_\\-]{7}:APA91b[A-Za-z0-9_\\-]{100,}"
    },
    {
      "category": "API_KEY",
      "name": "telegram_bot",
      "regex": "(?<![\\w])\\d{8,10}:[A-Za-z0-9_\\-]{35}(?![\\w\\-])"
    },
    {
      "category": "KV_SECRET",
      "name": "header_auth_like",
      "regex": "(?<![\\w\\-])(?:authorization|proxy-authorization|x-api-key|x-auth-token|x-access-token|private-token|api-key|apikey|x-goog-api-key|ocp-apim-subscription-key)[ \\t]*:[ \\t]*(\\S(?:[^\\n]*\\S)?)",
      "flags": "I",
      "group": 1
    },
    {
      "category": "KV_SECRET",
      "name": "header_cookie",
      "regex": "(?<![\\w\\-])(?:cookie|set-cookie)[ \\t]*:[ \\t]*(\\S(?:[^\\n]*\\S)?)",
      "flags": "I",
      "group": 1
    },
    {
      "category": "KV_SECRET",
      "name": "json_quoted_value",
      "regex": "\"[\\w.\\-]*(?:key|secret|token|pass(?:word|wd|phrase|code)?|auth|cred(?:ential)?)s?(?![a-z])[\\w.\\-]*\"[ \\t]*:[ \\t]*\"([^\"\\n]{4,})\"",
      "flags": "I",
      "group": 1,
      "check": "kv_value"
    },
    {
      "category": "KV_SECRET",
      "name": "kv_quoted_value",
      "regex": "(?<![\\w.\\-])[\\w.\\-]*(?:key|secret|token|pass(?:word|wd|phrase|code)?|auth|cred(?:ential)?)s?(?![a-z])[\\w.\\-]*[ \\t]*[:=][ \\t]*([\"'])([^\"'\\n]{4,})\\1",
      "flags": "I",
      "group": 2,
      "check": "kv_value"
    },
    {
      "category": "KV_SECRET",
      "name": "kv_bare_value",
      "regex": "(?<![\\w.\\-])[\\w.\\-]*(?:key|secret|token|pass(?:word|wd|phrase|code)?|auth|cred(?:ential)?)s?(?![a-z])[\\w.\\-]*[ \\t]*[:=][ \\t]*(?![\"'\\[{]|(?:true|false|null|none|yes|no)(?![\\w.\\-])|-?\\d+(?:\\.\\d+)?(?![^\\s\"',;]))([^\\s\"',;]{4,})",
      "flags": "I",
      "group": 1,
      "check": "kv_value"
    },
    {
      "category": "KV_SECRET",
      "name": "env_assignment_line",
      "regex": "^[A-Z][A-Z0-9_]{2,}[ \\t]*=[ \\t]*(\\S{8,})[ \\t]*$",
      "flags": "M",
      "group": 1,
      "check": "kv_value"
    },
    {
      "category": "EMAIL",
      "name": "email_standard",
      "regex": "(?<![\\w.+\\-])[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}"
    },
    {
      "category": "EMAIL",
      "name": "email_obfuscated",
      "regex": "[A-Za-z0-9._\\-]+[ \\t]*[\\[(][ \\t]*at[ \\t]*[\\])][ \\t]*[A-Za-z0-9\\-]+(?:(?:[ \\t]*[\\[(][ \\t]*dot[ \\t]*[\\])][ \\t]*|\\.)[A-Za-z0-9\\-]+)+",
      "flags": "I"
    },
    {
      "category": "PHONE",
      "name": "phone_egypt",
      "regex": "(?<![A-Za-z0-9_])(?:00[ \\t\\-]?20[ \\t\\-]?|0)1[0125](?:[ \\t\\-]?\\d){8}(?!\\d)",
      "check": "phone_context"
    },
    {
      "category": "PHONE",
      "name": "phone_international",
      "regex": "(?<![A-Za-z_+])\\+(?:[ \\t\\-]?\\d){9,15}(?!\\d)",
      "note": "explicit '+cc' form: no keyword-context check, Arabic/arrow/paren/digit before '+' allowed (a sum like 9+123456789 is redacted too - Zero-Compromise, T14-3); only a letter/_/+ glued before '+' is an identifier"
    },
    {
      "category": "PHONE",
      "name": "phone_egypt_e164_bare",
      "regex": "(?<![0-9+])201[0125]\\d{8}(?!\\d)",
      "note": "E.164 Egyptian mobile without '+': explicit country code, so no keyword-context exception (T14-3); '_'/letters before it are allowed (file names, ids)"
    },
    {
      "category": "PII",
      "name": "egypt_national_id",
      "regex": "(?<!\\d)[23]\\d{13}(?!\\d)"
    },
    {
      "category": "PII",
      "name": "egypt_iban",
      "regex": "(?<![\\w])EG\\d{27}(?![\\w])"
    },
    {
      "category": "PII",
      "name": "card_luhn",
      "regex": "(?<![\\d\\-])(?:\\d[ \\-]?){12,18}\\d(?![\\d\\-])",
      "check": "luhn"
    },
    {
      "category": "PATH",
      "name": "home_windows_drive",
      "regex": "[A-Za-z](?::|%3A)(?:[\\\\/]|%5[Cc]|%2[Ff])+Users(?:[\\\\/]|%5[Cc]|%2[Ff])+(?:(?!%2[Ff]|%5[Cc])[^\\\\/\\s\"'<>|:*?`])+",
      "note": "no leading lookbehind (glued protobuf byte, T13-3); supports %3A/%2F/%5C in file/app-resource URIs and stops before backtick (T16-2)",
      "flags": "I",
      "replacement": "~"
    },
    {
      "category": "PATH",
      "name": "home_windows_bare",
      "regex": "(?<![A-Za-z0-9_:/\\\\~])\\\\?Users\\\\+[^\\\\/\\s\"'<>|:*?`]+",
      "note": "Users\\<name> quoted without its drive letter (after a backtick / space) still names the account (T14-3)",
      "flags": "I",
      "replacement": "~"
    },
    {
      "category": "PATH",
      "name": "home_wsl_or_msys",
      "regex": "(?<![\\w/])/(?:mnt/)?[A-Za-z]/Users/[^/\\s\"'<>|]+",
      "flags": "I",
      "replacement": "~"
    },
    {
      "category": "PATH",
      "name": "home_linux",
      "regex": "(?<![\\w/])/home/[^/\\s\"'<>|]+",
      "replacement": "~"
    },
    {
      "category": "PATH",
      "name": "home_macos",
      "regex": "(?<![\\w/])/Users/[^/\\s\"'<>|]+",
      "replacement": "~"
    },
    {
      "category": "PATH",
      "name": "home_env_var",
      "regex": "(?:%USERPROFILE%|%HOMEDRIVE%%HOMEPATH%|%HOMEPATH%|\\$\\{HOME\\}|\\$HOME(?![\\w]))",
      "flags": "I",
      "replacement": "~"
    },
    {
      "category": "PATH",
      "name": "denied_path_token",
      "regex": "(?<![\\w:/\\\\])(?:~|[A-Za-z]:)?(?:[\\\\/][^\\s\\\\/\"'<>|:*?`()\\[\\]]+)+",
      "check": "denied_path"
    }
  ]
}
